    <main class="main">
      {{ content | safe }}
      <footer class="footer">Made with <a href="https://www.11ty.dev/" target="_blank">11ty</a></footer>
    </main>
  </body>
  <script>
    const printBtn = document.querySelector('.print-btn');
    printBtn.addEventListener('click', function (e){
      e.preventDefault();
      print();
    });
  </script>
</html>
