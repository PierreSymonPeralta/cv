  <link rel="icon" type="image/png" sizes="32x32" href="{{ '/images/favicon-32x32.png' | url }}">
  <link rel="icon" type="image/png" sizes="16x16" href="{{ '/images/favicon-16x16.png' | url }}">
  {# <link rel="manifest" href="/site.webmanifest"> #}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/styles/styles.css' | url }}">
  <title>{{ pageTitle }}</title>
</head>
  <body>
    <header>
      <div class="container">
        <div class="title">
          <h1>{{pageTitle}}</h1>
          <p class="headline">Principal Software Engineer | Enterprise AI & Agents</p>
          <address class="contact-info">
            <a href="mailto:pierresymonperalta@gmail.com">pierresymonperalta@gmail.com</a>
            <a href="tel:+6581849775">+65 8184 9775</a>
            <span>Singapore</span>
          </address>
        </div>

        <nav class="nav-content">
          <ul class="nav-social-links">
            <li><a class="linkedin" target="_blank" href="https://www.linkedin.com/in/pierre-symon-peralta-b6a8a1117/">LinkedIn</a></li>
            <li><a class="github" target="_blank" href="https://github.com/PierreSymonPeralta">GitHub</a></li>
